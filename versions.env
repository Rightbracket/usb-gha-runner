# Pinned inputs for an image build. Bump these and rebuild to update.
DEBIAN_SUITE=trixie
# GitHub refuses runners that are too old, so "latest" resolves the newest
# release at build time and checks it against the SHA-256 in its release
# notes. Pin a version (and its RUNNER_SHA256) for a reproducible build.
RUNNER_VERSION=latest
RUNNER_SHA256=
SYSBOX_VERSION=0.6.7
SYSBOX_SHA256=
# Images are pinned by digest; build.sh refuses tags alone.
JOB_BASE_IMAGE=ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
REGISTRY_IMAGE=registry:2.8.3
# Size of the GHR-BOOT FAT32 partition. The data partition takes the rest of
# the stick on first boot.
FAT_MB=4096
