# Copy to runner.env in this folder. Lines starting with # are ignored.

# Repository (https://github.com/OWNER/REPO) or organization (https://github.com/OWNER).
GHR_URL=https://github.com/acme/app

# Organization runner group (optional; the Default group if empty).
#GHR_RUNNER_GROUP=Default

# Runner name prefix (optional; defaults to the machine name ghr-XXXX).
# Worker slots register as PREFIX-1, PREFIX-2, ...
#GHR_NAME_PREFIX=build-box

# Extra labels, comma separated. self-hosted, linux, x64, usb-live are always added.
#GHR_LABELS=gpu,big-disk

# Worker slots: 1 to 32, or auto = min(CPU threads / 2, RAM GB / 4).
GHR_WORKERS=auto

# Credential. Every job gets a one-time runner config, which needs either a
# GitHub App (recommended) or a fine-grained personal access token.
#   Repository runners: "Administration" read and write on the repository.
#   Organization runners: "Self-hosted runners" read and write on the organization.

# GitHub App:
GHR_APP_ID=123456
GHR_APP_INSTALLATION_ID=7654321
GHR_APP_PRIVATE_KEY_FILE=app-key.pem

# Or a fine-grained personal access token instead of the three lines above:
#GHR_PAT=github_pat_...

# SSH (off by default). Key-only login as user "ghr".
#GHR_SSH=on
#GHR_SSH_AUTHORIZED_KEYS_FILE=authorized_keys
