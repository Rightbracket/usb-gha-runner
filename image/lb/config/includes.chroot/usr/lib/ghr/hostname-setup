#!/bin/bash
# Name the machine ghr-<last 4 hex digits of the first wired NIC's MAC>.
set -u
udevadm settle -t 20 || true
mac=""
for n in /sys/class/net/*; do
  [ -e "$n/device" ] || continue          # physical NICs only
  [ "$(cat "$n/type")" = 1 ] || continue  # Ethernet
  [ -d "$n/wireless" ] && continue
  mac=$(cat "$n/address")
  break
done
hex=$(printf '%s' "${mac:-00:00:00:00:00:00}" | tr -d ':')
name="ghr-${hex: -4}"
echo "$name" >/etc/hostname
hostname "$name"
sed -i '/^127\.0\.1\.1/d' /etc/hosts
echo "127.0.1.1 $name $name.local" >>/etc/hosts
# Use systemd-resolved's stub resolver.
if [ "$(readlink /etc/resolv.conf)" != "../run/systemd/resolve/stub-resolv.conf" ]; then
  ln -sf ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
fi
echo "hostname set to $name"
